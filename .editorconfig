root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown은 줄 끝 공백 두 칸이 줄바꿈 의미라 지우지 않는다
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
